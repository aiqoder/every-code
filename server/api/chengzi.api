syntax = "v1"

info (
	title:   "chengzi-agent-server"
	desc:    "AI Agent 平台 API"
	author:  "chengzi"
	version: "v1"
)

// ---------- 通用 ----------
type Empty {}

type IdPathReq {
	Id uint64 `path:"id"`
}

type PageReq {
	Page     int `form:"page,optional,default=1"`
	PageSize int `form:"pageSize,optional,default=20"`
}

type HealthResp {
	Status string `json:"status"`
}

// ---------- Auth ----------
// 账号体系迁移到 user-feedback：仅保留登录（透传令牌）与 OAuth2 授权码登录。
type LoginReq {
	Username string `json:"username"`
	Password string `json:"password"`
}

type OAuthAuthorizeReq {
	State string `form:"state,optional"`
}

type OAuthAuthorizeResp {
	Url   string `json:"url"`
	State string `json:"state"`
}

type OAuthCallbackReq {
	Code string `form:"code"`
}

type OAuthCallbackResp {
	Token    string     `json:"token"`
	User     AuthUserVO `json:"user"`
	Redirect string     `json:"redirect"`
}

type AuthUserVO {
	ID           uint64 `json:"id"`
	Username     string `json:"username"`
	Name         string `json:"name"`
	Role         string `json:"role"`
	IsSuperAdmin bool   `json:"isSuperAdmin"`
}

type AuthResult {
	Token string     `json:"token"`
	User  AuthUserVO `json:"user"`
}

type AuthResp {
	Token string     `json:"token"`
	User  AuthUserVO `json:"user"`
}

type UserResp {
	User AuthUserVO `json:"user"`
}

// ---------- API Key ----------
type CreateApiKeyReq {
	Name string `json:"name"`
}

type ApiKeyListResp {
	List interface{} `json:"list"`
}

type ApiKeyRevealResp {
	Key string `json:"key"`
}

// ---------- LLM Provider ----------
type LlmProviderReq {
	Name                    string `json:"name"`
	Website                 string `json:"website,optional"`
	APIKey                  string `json:"apiKey,optional"`
	OpenAICompatibleBaseURL string `json:"openaiCompatibleBaseUrl,optional"`
	AnthropicBaseURL        string `json:"anthropicBaseUrl,optional"`
}

type LlmProviderListReq {
	PageReq
	All bool `form:"all,optional"`
}

type LlmProviderListResp {
	List     interface{} `json:"list"`
	Total    int64       `json:"total,optional"`
	Page     int         `json:"page,optional"`
	PageSize int         `json:"pageSize,optional"`
}

type RemoteModelsResp {
	List interface{} `json:"list"`
}

// ---------- LLM Model ----------
type LlmModelReq {
	ProviderID         uint64   `json:"providerId"`
	Name               string   `json:"name"`
	Attachment         bool     `json:"attachment,optional"`
	Reasoning          bool     `json:"reasoning,optional"`
	ReasoningOptions   []string `json:"reasoningOptions,optional"`
	Temperature        bool     `json:"temperature,optional"`
	InputCapabilities  []string `json:"inputCapabilities,optional"`
	InputContextLimit  *int64   `json:"inputContextLimit,optional"`
	OutputContextLimit *int64   `json:"outputContextLimit,optional"`
	InputPrice         float64  `json:"inputPrice,optional"`
	OutputPrice        float64  `json:"outputPrice,optional"`
	CachePrice         float64  `json:"cachePrice,optional"`
}

type LlmModelListReq {
	PageReq
	ProviderId uint64 `form:"providerId,optional"`
}

type LlmModelListResp {
	List     interface{} `json:"list"`
	Total    int64       `json:"total"`
	Page     int         `json:"page"`
	PageSize int         `json:"pageSize"`
}

type InputCapabilitiesResp {
	List interface{} `json:"list"`
}

// ---------- Agent ----------
type AgentReq {
	Name         string   `json:"name"`
	Description  string   `json:"description,optional"`
	SystemPrompt string   `json:"systemPrompt,optional"`
	Skills       []string `json:"skills,optional"`
	Avatar       string   `json:"avatar,optional"`
	// MaxSteps 单轮最大模型调用步数；0 表示使用服务端默认值。
	MaxSteps int `json:"maxSteps,optional"`
	// Version 版本号（与 cpk 安装包 manifest.version 对齐），可选。
	Version string `json:"version,optional"`
}

type AgentListResp {
	List     interface{} `json:"list"`
	Total    int64       `json:"total"`
	Page     int         `json:"page"`
	PageSize int         `json:"pageSize"`
}

type SkillListResp {
	List interface{} `json:"list"`
}

// ---------- Conversation ----------
type CreateConversationReq {
	ModelId   uint64 `json:"modelId"`
	ClientId  string `json:"clientId,optional"`
	Title     string `json:"title,optional"`
	Workspace string `json:"workspace,optional"`
}

type UpdateConversationWorkspaceReq {
	Workspace string `json:"workspace"`
}

// ListConversationsReq 用户侧会话列表。clientId 非空时只返回该客户端的会话。
type ListConversationsReq {
	PageReq
	ClientId string `form:"clientId,optional"`
}

type ConversationListResp {
	List     interface{} `json:"list"`
	Total    int64       `json:"total"`
	Page     int         `json:"page"`
	PageSize int         `json:"pageSize"`
}

type ChatAttachment {
	FileName string `json:"fileName"`
	MimeType string `json:"mimeType,optional"`
	Data     string `json:"data"`
}

type ChatReq {
	Content     string           `json:"content"`
	AgentId     string           `json:"agentId"`
	ClientId    string           `json:"clientId"`
	Attachments []ChatAttachment `json:"attachments,optional"`
}

type RevertConversationReq {
	Id        uint64 `path:"id"`
	MessageId uint64 `json:"messageId"`
}

// ---------- Tool ----------
type ToolReq {
	Name        string                 `json:"name"`
	DisplayName string                 `json:"displayName"`
	Description string                 `json:"description,optional"`
	Parameters  map[string]interface{} `json:"parameters,optional"`
	Type        string                 `json:"type,optional"`
	Extra       map[string]interface{} `json:"extra,optional"`
	Version     int64                  `json:"version,optional"`
}

type TokenUsageStatsReq {
	Range string `form:"range,optional,default=today"`
}

type TokenUsageStatsResp {
	PromptTokens        int64       `json:"promptTokens"`
	CompletionTokens    int64       `json:"completionTokens"`
	CacheCreationTokens int64       `json:"cacheCreationTokens"`
	CacheReadTokens     int64       `json:"cacheReadTokens"`
	RealTokens          int64       `json:"realTokens"`
	RequestCount        int64       `json:"requestCount"`
	Cost                float64     `json:"cost"`
	CacheHitRate        float64     `json:"cacheHitRate"`
	Range               string      `json:"range"`
	Trend               interface{} `json:"trend"`
}

type TokenUsageTrendPoint {
	At                  string  `json:"at"`
	PromptTokens        int64   `json:"promptTokens"`
	CompletionTokens    int64   `json:"completionTokens"`
	CacheCreationTokens int64   `json:"cacheCreationTokens"`
	CacheReadTokens     int64   `json:"cacheReadTokens"`
	Cost                float64 `json:"cost"`
}

type ToolListResp {
	List     interface{} `json:"list"`
	Total    int64       `json:"total"`
	Page     int         `json:"page"`
	PageSize int         `json:"pageSize"`
}

// ---------- Client ----------
type ClientListResp {
	List interface{} `json:"list"`
}

type ClientToolMeta {
	Name        string                 `json:"name"`
	Description string                 `json:"description,optional"`
	Parameters  map[string]interface{} `json:"parameters,optional"`
}

type ClientSkillMeta {
	Id          string `json:"id"`
	Name        string `json:"name"`
	Description string `json:"description,optional"`
	Source      string `json:"source,optional"`
	Path        string `json:"path,optional"`
}

type UpdateCatalogReq {
	ClientId    string            `json:"clientId"`
	Tools       []ClientToolMeta  `json:"tools,optional"`
	Skills      []ClientSkillMeta `json:"skills,optional"`
	PageChannel string            `json:"pageChannel,optional"`
	OsInfo      string            `json:"osInfo"`
	Workspace   string            `json:"workspace"`
}

// ========== 路由 ==========
@server (
	prefix: /api
	group:  health
)
service chengzi {
	@handler ping
	get /health returns (HealthResp)
}

@server (
	prefix: /api/auth
	group:  auth
)
service chengzi {
	@handler login
	post /login (LoginReq) returns (AuthResp)

	@handler oauthAuthorize
	get /oauth/authorize (OAuthAuthorizeReq) returns (OAuthAuthorizeResp)

	@handler oauthCallback
	get /oauth/callback (OAuthCallbackReq) returns (OAuthCallbackResp)
}

@server (
	prefix:     /api/auth
	middleware: Auth
	group:      authAuthed
)
service chengzi {
	@handler me
	get /me returns (UserResp)
}

@server (
	prefix:     /api
	middleware: Auth
	group:      apiKey
)
service chengzi {
	@handler createApiKey
	post /api-keys (CreateApiKeyReq)

	@handler listApiKeys
	get /api-keys returns (ApiKeyListResp)

	@handler revealApiKey
	get /api-keys/:id (IdPathReq) returns (ApiKeyRevealResp)

	@handler deleteApiKey
	delete /api-keys/:id (IdPathReq)
}

@server (
	prefix:     /api
	middleware: Auth
	group:      llmModel
)
service chengzi {
	@handler inputCapabilities
	get /llm-models/input-capabilities returns (InputCapabilitiesResp)

	@handler listLlmModels
	get /llm-models (LlmModelListReq) returns (LlmModelListResp)

	@handler getLlmModel
	get /llm-models/:id (IdPathReq)

	@handler createLlmModel
	post /llm-models (LlmModelReq)

	@handler updateLlmModel
	put /llm-models/:id (LlmModelReq)

	@handler deleteLlmModel
	delete /llm-models/:id (IdPathReq)
}

@server (
	prefix:     /api
	middleware: Auth
	group:      llmprovider
)
service chengzi {
	@handler listLlmProviders
	get /llm-providers (LlmProviderListReq) returns (LlmProviderListResp)

	@handler getLlmProvider
	get /llm-providers/:id (IdPathReq)

	@handler createLlmProvider
	post /llm-providers (LlmProviderReq)

	@handler updateLlmProvider
	put /llm-providers/:id (LlmProviderReq)

	@handler deleteLlmProvider
	delete /llm-providers/:id (IdPathReq)

	@handler listRemoteModels
	get /llm-providers/:id/remote-models (IdPathReq) returns (RemoteModelsResp)
}

type ListSkillsReq {
	ClientId string `form:"clientId,optional"`
	AgentId  string `form:"agentId,optional"`
}

@server (
	prefix:     /api
	middleware: Auth
	group:      agent
)
service chengzi {
	@handler listSkills
	get /agents/skills (ListSkillsReq) returns (SkillListResp)
}

@server (
	prefix:     /api
	middleware: Auth
	group:      conversation
)
service chengzi {
	@handler createConversation
	post /conversations (CreateConversationReq)

	@handler listConversations
	get /conversations (ListConversationsReq) returns (ConversationListResp)

	@handler getConversation
	get /conversations/:id (IdPathReq)

	@handler deleteConversation
	delete /conversations/:id (IdPathReq)

	@handler updateConversationWorkspace
	put /conversations/:id/workspace (UpdateConversationWorkspaceReq)

	@handler getTokenUsage
	get /token-usage (TokenUsageStatsReq) returns (TokenUsageStatsResp)
}

@server (
	prefix:     /api
	middleware: Auth
	group:      client
)
service chengzi {
	@handler listClients
	get /clients returns (ClientListResp)

	@handler updateCatalog
	put /clients/catalog (UpdateCatalogReq)
}

@server (
	prefix:     /api
	middleware: Auth
	group:      tool
)
service chengzi {
	@handler listTools
	get /tools (PageReq) returns (ToolListResp)

	@handler getTool
	get /tools/:id (IdPathReq)
}

@server (
	prefix:     /api
	middleware: Auth,AuthAdmin
	group:      admin
)
service chengzi {
	@handler createLlmProvider
	post /admin/llm-providers (LlmProviderReq)

	@handler listLlmProviders
	get /admin/llm-providers (LlmProviderListReq) returns (LlmProviderListResp)

	@handler getLlmProvider
	get /admin/llm-providers/:id (IdPathReq)

	@handler listRemoteModels
	get /admin/llm-providers/:id/remote-models (IdPathReq) returns (RemoteModelsResp)

	@handler updateLlmProvider
	put /admin/llm-providers/:id (LlmProviderReq)

	@handler listAdminLlmModels
	get /admin/llm-models (LlmModelListReq) returns (LlmModelListResp)

	@handler createLlmModel
	post /admin/llm-models (LlmModelReq)

	@handler updateLlmModel
	put /admin/llm-models/:id (LlmModelReq)

	@handler listAdminTools
	get /admin/tools (PageReq) returns (ToolListResp)

	@handler getAdminTool
	get /admin/tools/:id (IdPathReq)

	@handler createAdminTool
	post /admin/tools (ToolReq)

	@handler updateAdminTool
	put /admin/tools/:id (ToolReq)

	@handler deleteAdminTool
	delete /admin/tools/:id (IdPathReq)

	@handler listAdminConversations
	get /admin/conversations (PageReq) returns (ConversationListResp)

	@handler getAdminConversation
	get /admin/conversations/:id (IdPathReq)

	@handler deleteAdminConversation
	delete /admin/conversations/:id (IdPathReq)
}

